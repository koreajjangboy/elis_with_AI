# 국가법령정보센터 Open API 인증키(OC)
LAW_API_OC=

# Upstage API 키 (Solar Embedding 2). 없으면 LLM_API_KEY를 대신 사용
UPSTAGE_API_KEY=
LLM_API_KEY=

# 클라우드 PostgreSQL (pgvector) 접속 URL
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# RAG 답변 LLM. 비우면 ANTHROPIC_API_KEY가 있으면 anthropic, 없으면 upstage(UPSTAGE_API_KEY 재사용)
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
UPSTAGE_CHAT_MODEL=solar-pro3

# Streamlit이 호출할 API 주소
ELIS_API_URL=http://localhost:8000
